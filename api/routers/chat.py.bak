router = APIRouter(tags=["chat"])
logger = logging.getLogger("bos.chat")

_RUN_RE = re.compile(r"RUN:\s*([a-zA-Z0-9_.]+)")


def _strip_run_directives(text: str) -> str:
    """Remove hidden module-control directives from user-visible CMO copy."""
    cleaned = _RUN_RE.sub("", text)
    cleaned = re.sub(r"[ \t]+\n", "\n", cleaned)
    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned)
    cleaned = re.sub(r" {2,}", " ", cleaned)
    return cleaned.strip(" \n\t-—")


def _chat_modules() -> list[dict]:
    """Modules the CMO chat is allowed to dispatch from natural language."""
    allowed_module_ids = {
        s.module_id
        for s in list_skill_manifests()
        if s.allowed_from_chat and s.module_id and {"generation", "revision", "diagnostic"}.intersection(s.requires_intent)
    }
    return [m for m in list_all() if m["id"] in allowed_module_ids]


def _has_generation_intent(message: str) -> bool:
    text = message.lower()
    intent_patterns = [
        r"\b(generate|create|write|draft|make|produce|show me|let me see|get me|build|design)\b",
        r"\b(give me|can you make|please make|need|i need)\b",
        r"\b(revise|redo|modify|update|change|improve|shorten|lengthen|rewrite)\b",
    ]
    return any(re.search(pattern, text) for pattern in intent_patterns)


def _has_revision_intent(message: str) -> bool:
    text = message.lower()
    return bool(re.search(r"\b(revise|redo|modify|update|change|improve|shorten|lengthen|rewrite|again|more|less)\b", text))


def _has_diagnostic_intent(message: str) -> bool:
    text = message.lower()
    return bool(re.search(r"\b(performance|report|how (?:are|is|did)|doing|spend|conversions|cpa|ctr|analyze|analyse|summary|health|check|look up|pull|fetch|campaign updates?|campaign related|google ads)\b", text))


def _requested_module_ids(message: str, modules: list[dict]) -> list[str]:
    """Return modules explicitly requested by channel name in the current user message.

    This is intentionally deterministic. The LLM may decide *whether* to run modules,
    but punctuation/abbreviations in a user's channel list must not cause BOS to drop
    valid RUN triggers.
    """
    text = message.lower()
    requested: list[str] = []

    # Handle "all" or "all of them" — return ALL available modules
    if re.search(r"\ball\b", text) or re.search(r"all of them", text):
        return [m["id"] for m in modules]

    def add(module_id: str) -> None:
        if module_id not in requested:
            requested.append(module_id)

    for m in modules:
        module_id = m["id"]
        hint = (m.get("platform_hint") or module_id.rsplit(".", 1)[-1]).lower().replace("_", " ")
        leaf = module_id.rsplit(".", 1)[-1].lower().replace("_", " ")
        candidates = {hint, leaf, *hint.split(), *leaf.split()}

        if "facebook" in candidates:
            candidates.update({"fb", "facebok"})
        if "twitter" in candidates:
            candidates.update({"tw", "twit", "tweet", "tweets", "twet", "x"})
        if "google" in candidates:
            candidates.update({"goog", "google ads", "search ads", "ppc"})
        if "email" in candidates:
            candidates.update({"mail", "e-mail", "emails", "cold email", "outreach"})

        for candidate in sorted(c for c in candidates if len(c) >= 2):
            pattern = r"(?<![a-z0-9])" + re.escape(candidate) + r"(?![a-z0-9])"
            if re.search(pattern, text):
                add(module_id)
                break

    return requested


class ChatHistoryItem(BaseModel):
    role: str  # "user" or "ai"
    text: str


class ChatRequest(BaseModel):
    message: str
    history: list[ChatHistoryItem] = []


class ChatResponse(BaseModel):
    reply: str
    runs: list[RunResponse] = []
    # kept for single-run callers; mirrors runs[0] when there is exactly one result
    run: RunResponse | None = None
    module_id: str | None = None


class ChatReviseRequest(BaseModel):
    feedback: str = ""
    history: list[ChatHistoryItem] = []


async def _build_system_prompt(db: AsyncSession, ws, modules: list[dict], skill_context: str = "") -> str:
    ws_name = ws.name if ws else "this business"

    brand_ctx = ""
    if ws and ws.brand_json:
        voice = ws.brand_json.get("voice", "")
        tone = ws.brand_json.get("tone", "")
        values = ws.brand_json.get("values", [])
        parts = [f"voice: {voice}" if voice else "", f"tone: {tone}" if tone else "", f"values: {', '.join(values)}" if values else ""]
        brand_ctx = "\nBrand — " + ", ".join(p for p in parts if p) + "."

    workspace_ctx = ""
    if ws:
        product_rows = (await db.execute(select(Product).where(Product.workspace_id == ws.id).order_by(Product.created_at.asc()))).scalars().all()
        audience_rows = (await db.execute(select(Audience).where(Audience.workspace_id == ws.id).order_by(Audience.created_at.asc()))).scalars().all()
        kit = (await db.execute(
            select(WorkspaceDocument)
            .where(WorkspaceDocument.workspace_id == ws.id, WorkspaceDocument.doc_type == "campaign_brand_kit")
            .order_by(WorkspaceDocument.status.desc(), WorkspaceDocument.updated_at.desc())
            .limit(1)
        )).scalar_one_or_none()
        brand_guideline = (await db.execute(
            select(WorkspaceDocument)
            .where(WorkspaceDocument.workspace_id == ws.id, WorkspaceDocument.doc_type == "brand_guideline")
            .order_by(WorkspaceDocument.status.desc(), WorkspaceDocument.updated_at.desc())
            .limit(1)
        )).scalar_one_or_none()

        product_lines = []
        for p in product_rows:
            benefits = (p.benefits_json or {}).get("benefits", [])
            product_lines.append(f"- {p.name}: {p.tagline or 'no tagline'}" + (f"; benefits: {', '.join(benefits)}" if benefits else ""))

        audience_lines = []
        for a in audience_rows:
            seg = a.segment_json or {}
            pain = seg.get("pain_points", [])
            examples = seg.get("examples", [])
            priority = seg.get("priority", [])
            detail_parts = [seg.get('demographics', 'no demographics')]
            if examples:
                detail_parts.append(f"examples: {', '.join(examples)}")
            if priority:
                detail_parts.append(f"priority: {', '.join(priority)}")
            if pain:
                detail_parts.append(f"pains: {', '.join(pain)}")
            audience_lines.append(f"- {a.name}: " + "; ".join(detail_parts))

        kit_excerpt = ""
        kit_status = "none"
        if kit and kit.content_markdown:
            kit_status = kit.status or "ingested"
            kit_excerpt = kit.content_markdown[:5000]

        guideline_excerpt = ""
        if brand_guideline and brand_guideline.content_markdown:
            guideline_excerpt = brand_guideline.content_markdown[:6000]

        workspace_ctx = "\n\nKnown project context from the approved/ingested workspace brief:\n"
        workspace_ctx += f"Company/brand: {ws_name}\n"
        workspace_ctx += f"Brand kit status: {kit_status}\n"
        if product_lines:
            workspace_ctx += "Products/offers:\n" + "\n".join(product_lines) + "\n"
        if audience_lines:
            workspace_ctx += "Target audiences:\n" + "\n".join(audience_lines) + "\n"
        if guideline_excerpt:
            workspace_ctx += "Brand Guidelines / Strategic Brief excerpt:\n" + guideline_excerpt + "\n"
        if kit_excerpt:
            workspace_ctx += "Campaign Brand Kit excerpt:\n" + kit_excerpt + "\n"

    module_lines = [
        f"  - {(m.get('platform_hint') or m['id'].rsplit('.', 1)[-1]).replace('_', ' ').title()} (module: {m['id']})"
        for m in modules
    ]
    modules_str = "\n".join(module_lines) if module_lines else "  (none registered)"

    operational_ctx = f"""

Operational connector context, for explicit system/connector questions only:
- MCP means Model Context Protocol, a connector layer BOS can use behind the scenes.
{format_connector_status_for_prompt()}
- If the user asks generally to check the MCP system, answer with connector status from the registry. Do not say you are unaware of MCP.
- If the user asks for a channel/report and a matching connector-backed module is available, use that module rather than explaining MCP.
"""

    # Build a complete skill catalog for "what can you do" / capabilities questions
    all_manifests = list_skill_manifests()
    skill_catalog_lines = ["BOS Skill Catalog (all available skills):"] 
    for m in all_manifests:
        trigger_hint = ', '.join(m.triggers[:3]) if m.triggers else 'general'
        module_hint = f" (module: {m.module_id})" if m.module_id else ""
        skill_catalog_lines.append(f"  - {m.name or m.id}: {m.description[:100]}... [triggers: {trigger_hint}]{module_hint}")
    skill_catalog = "\n".join(skill_catalog_lines)

    return f"""You are the Chief Marketing Officer for {ws_name}.{brand_ctx}{workspace_ctx}{operational_ctx}

Be concise by default, but when the user asks what the project/brand/system is about, answer using the known project and operational context above. Do not claim details are unspecified if products, audiences, a brand kit, or connector context are present.

BOS Skill Catalog (all available skills):
{skill_catalog}

Activated BOS skill context:
{skill_context or "No activated skill context."}

Available content modules:
{modules_str}

CRITICAL INSTRUCTIONS:
1. When user explicitly names channels, reply briefly then add RUN: lines for each named channel module.

2. Trigger content modules only when the user is clearly asking you to create, write, draft, generate, run, revise, modify, or redo collateral. Trigger analytics/reporting modules when the user asks for performance, spend, conversions, CPA, CTR, campaign health, or a report.

3. If the user is asking a discussion/question/context question, DO NOT trigger modules — answer conversationally only.
   - "tell me everything you know about the current project" → no RUN lines
   - "what is this about?" → no RUN lines
   - "what channels can we use?" → no RUN lines

4. When the user asks for sample ads/collateral, HANDLE IT:
   - User says "all" or "all of them" → MUST output RUN: lines for ALL ad modules:
     RUN:marketing.channel.twitter.paid.ads.copy
     RUN:marketing.channel.google.paid_search.ads.text
     RUN:marketing.channel.facebook.paid.ads.copy
   - User names specific channels → ADD RUN: LINES for ONLY those channels
   - User does NOT name channels → ask which channels they want
   Never write generic prose samples yourself. Always dispatch modules for platform-native output.

   EXAMPLE: If user says "show me ad samples all of them", you MUST reply:
   "Here are your ad samples:"
   RUN:marketing.channel.twitter.paid.ads.copy
   RUN:marketing.channel.google.paid_search.ads.text
   RUN:marketing.channel.facebook.paid.ads.copy"

5. Only trigger RUN: for channels user explicitly names in their current message, or for clear revision follow-ups that refer to drafts already being revised.

6. Never mention RUN:, module IDs, or technical details in your reply text.
   Put RUN: lines AFTER your reply text, each on its own line.

7. If the user says MCP in a Google Ads context, interpret it as the behind-the-scenes Google Ads connector, not "Marketing Campaign Platform". Do not invent live campaign setup details; dispatch the available report module or say you need connector data.

8. For positioning, market-segment, ICP, or strategy questions, distinguish between stored context and finalized strategy. Use the explicit audience examples and priority lists in the workspace context before brainstorming unrelated markets. Do not present a stored existing audience as a new market segment; instead recommend the best next subcategory or vertical within the approved ICP pattern. If the user asks who Klaroha should target next, prioritize the named high-value categories in context — especially Microsoft MSPs/cybersecurity providers for international B2B expansion when present — rather than generic ecommerce, generic agencies, or broad SMBs.

9. When the user asks what you can do or about your capabilities, answer AS A CHIEF MARKETING OFFICER using the **BOS Skill Catalog** and **Available content modules** listed above. Do not describe yourself as customer support, an information desk, or a VA. Reference the actual skills and modules available from the catalog."""


# Preferred model per provider for the conversational intent call
_CHAT_MODELS: dict[str, str] = {
    "gemini": "gemini-2.0-flash",
    "nvidia": "meta/llama-3.3-70b-instruct",
    "openrouter": "openai/gpt-4o-mini",
    "openai": "gpt-5.1",
}


async def _complete_cmo_messages(
    db: AsyncSession,
    ws,
    settings,
    messages: list[dict],
) -> str | None:
    candidates: list[tuple[str, str, str, str | None]] = []

    configured_chat_model = None
    if ws:
        configured_chat_model = await resolve_backend_override(db, ws.id, "cmo.main")
    configured_chat_model = configured_chat_model or get_backend_override(settings, "cmo.main") or parse_model_ref(getattr(settings, "cmo_chat_model", ""))
    if configured_chat_model and configured_chat_model.modality != "text":
        logger.error("Configured CMO backend must use text modality, got '%s'", configured_chat_model.modality)
        return None
    chat_models = (
        {configured_chat_model.provider: configured_chat_model.model_id}
        if configured_chat_model and configured_chat_model.model_id
        else _CHAT_MODELS
    )

    def add_candidate(provider: str, model_id: str, key: str, auth_mode: str | None) -> None:
        identity = (provider, model_id, auth_mode or "platform")
        if any((p, m, a or "platform") == identity for p, m, _, a in candidates):
            return
        candidates.append((provider, model_id, key, auth_mode))

    # Try the operator-configured CMO backend first, but do not let a bad model
    # override take the whole CMO offline when other credentials are available.
    if configured_chat_model and configured_chat_model.model_id:
        provider = configured_chat_model.provider
        model_id = configured_chat_model.model_id
        if ws:
            key, auth_mode = await resolve_stored_provider_credential(db, ws.id, provider, settings)
            if key:
                add_candidate(provider, model_id, key, auth_mode)
        platform_key = get_platform_key(provider, settings)
        if platform_key:
            add_candidate(provider, model_id, platform_key, None)

    if ws:
        for provider, model_id in _CHAT_MODELS.items():
            key, auth_mode = await resolve_stored_provider_credential(db, ws.id, provider, settings)
            if key:
                if provider == "openai" and auth_mode == "api_key":
                    model_id = "gpt-4o-mini"
                add_candidate(provider, model_id, key, auth_mode)

    for provider, model_id in _CHAT_MODELS.items():
        platform_key = get_platform_key(provider, settings)
        if platform_key:
            add_candidate(provider, model_id, platform_key, None)

    if configured_chat_model and not candidates:
        logger.error(
            "Configured CMO_CHAT_MODEL %s/%s has no available credential and no fallback credentials are available",
            configured_chat_model.provider,
            configured_chat_model.model_id,
        )

    for provider, model_id, api_key, auth_mode in candidates:
        try:
            adapter = get_adapter(provider, api_key, auth_mode)
            response = await adapter.complete_messages(messages, model_id)
            logger.info("Chat via %s/%s", provider, model_id)
            return response.content
        except Exception as exc:
            logger.warning("Chat %s/%s failed: %s", provider, model_id, exc)

    return None


@router.post("/chat", response_model=ChatResponse)
async def chat(
    body: ChatRequest,
    db: AsyncSession = Depends(get_db),
    _: str = Depends(require_api_key),
):
    settings = get_settings()
    ws = await get_singleton(db)
    routed = route_chat_skills(body.message)
    if not routed.module_ids and len(body.message.strip().split()) <= 5 and body.history:
        recent_user_context = "\n".join(h.text for h in body.history[-6:] if h.role == "user")
        contextual_routed = route_chat_skills((recent_user_context + "\n" + body.message).strip())
        if contextual_routed.module_ids:
    # FORCE dispatch for "all of them" - bypass LLM RUN: line issues
    force_dispatch_all = False
    msg_lower = body.message.lower()
    if (re.search(r"\ball\b", msg_lower) or re.search(r"all of them", msg_lower)) and routed.module_ids:
        logger.warning("FORCE: User requested ALL - will dispatch: %s", list(routed.module_ids))
        force_dispatch_all = True

            routed = contextual_routed
    modules = [m for m in _chat_modules() if m["id"] in set(routed.module_ids)]
    user_message = body.message
    activated_skill_ids = [route.skill.id for route in routed.routes]
    memory_slots = sorted({slot for route in routed.routes for slot in route.skill.memory_slots})
    hydrated_memory = await hydrate_memory_slots(db, ws, memory_slots)
    loaded_skills = [get_skill(skill_id) for skill_id in activated_skill_ids]
    skill_sections = [
        format_activated_skill(skill)
        for skill in loaded_skills
        if skill is not None
    ]
    skill_context = "\n\n".join(skill_sections + ["## Hydrated Workspace Memory\n" + compile_memory_context(hydrated_memory)])

    system = await _build_system_prompt(db, ws, modules, skill_context)
    messages: list[dict] = [{"role": "system", "content": system}]
    for h in body.history[-8:]:
        messages.append({"role": "user" if h.role == "user" else "assistant", "content": h.text})
    messages.append({"role": "user", "content": user_message})

    raw_reply = await _complete_cmo_messages(db, ws, settings, messages)

    if raw_reply is None:
        logger.error("All chat providers failed — returning error to user")
        return ChatResponse(
            reply="I'm having trouble connecting to my AI services right now. Please check the provider settings in Workspace > Settings or try again in a moment.",
            runs=[],
            run=None,
            module_id=None,
        )

    triggered_modules = _RUN_RE.findall(raw_reply)
    reply_text = _strip_run_directives(raw_reply)

    # Debug: trace the dispatch logic
    logger.warning("DEBUG: triggered_modules from CMO: %s", triggered_modules)
    logger.warning("DEBUG: routed.module_ids: %s", routed.module_ids)

    allowed_module_ids = set(routed.module_ids)
    invalid_modules = [mid for mid in triggered_modules if mid not in allowed_module_ids]
    if invalid_modules:
        logger.warning("LLM triggered modules outside activated skill contracts — skipping: %s", invalid_modules)
    triggered_modules = [mid for mid in triggered_modules if mid in allowed_module_ids]
    
    requested_ids = _requested_module_ids(body.message, [m for m in modules if m["id"] in allowed_module_ids])
    logger.warning("DEBUG: requested_ids: %s", requested_ids)
    
    recent_user_context = "\n".join(h.text for h in body.history[-6:] if h.role == "user")
    intent_context = (recent_user_context + "\n" + body.message).strip()
    has_generation_intent = _has_generation_intent(intent_context)
    has_revision_intent = _has_revision_intent(intent_context)
    has_diagnostic_intent = _has_diagnostic_intent(intent_context)
    has_execution_intent = has_generation_intent or has_diagnostic_intent
    logger.warning("DEBUG: has_execution_intent: %s", has_execution_intent)

    if triggered_modules and not has_execution_intent:
        logger.warning("LLM triggered modules during non-execution discussion — skipping: %s", triggered_modules)
        triggered_modules = []
    elif triggered_modules and requested_ids:
        # User explicitly named channels and asked for generation/revision - validate against what they asked for.
        # Uses boundary regex matching, so "facebook," and "google ads" are handled.
        requested_set = set(requested_ids)
        validated_modules = [mid for mid in triggered_modules if mid in requested_set]
        if len(validated_modules) < len(triggered_modules):
            skipped = set(triggered_modules) - set(validated_modules)
            for mid in skipped:
                logger.warning("LLM triggered %s but user didn't request it — skipping", mid)
        triggered_modules = validated_modules or requested_ids
    elif triggered_modules and not requested_ids and not has_revision_intent:
        logger.warning("LLM triggered modules without explicit channel or revision intent — skipping: %s", triggered_modules)
        triggered_modules = []
    elif not triggered_modules and requested_ids and has_execution_intent:
        # Deterministic fallback: if the CMO reply forgot RUN lines but the user clearly
        # named channels/reports and asked for execution, still dispatch the requested modules.
        logger.warning("LLM returned no RUN lines; dispatching explicitly requested modules: %s", requested_ids)
        triggered_modules = requested_ids
    elif not triggered_modules and routed.module_ids and has_execution_intent:
        logger.warning("LLM returned no RUN lines; dispatching activated modules: %s", routed.module_ids)
        triggered_modules = list(routed.module_ids)

    run_results: list[RunResponse] = []

    if triggered_modules and ws:
        try:
            conversation_lines = [
                f"{h.role.upper()}: {h.text}" for h in body.history[-12:]
            ] + [f"USER: {body.message}"]
            chat_overrides = {"conversation_context": "\n".join(conversation_lines)}
            brief = await _resolve_brief(db, ws, chat_overrides)
            for module_id in triggered_modules:
                try:
                    result = await _execute_module(db, ws, module_id, brief, settings)
                    run_results.append(result)
                except Exception as exc:
                    logger.error("Module dispatch failed for %s: %s", module_id, exc)
        except Exception as exc:
            logger.error("Brief resolution failed: %s", exc)

    return ChatResponse(
        reply=reply_text,
        runs=run_results,
        run=run_results[0] if run_results else None,
        module_id=triggered_modules[0] if triggered_modules else None,
    )


@router.post("/chat/runs/{run_id}/revise", response_model=ChatResponse, status_code=201)
async def chat_revise_run(
    run_id: str,
    body: ChatReviseRequest,
    db: AsyncSession = Depends(get_db),
    _: str = Depends(require_api_key),
):
    settings = get_settings()
    ws = await get_singleton(db)
    if not ws:
        raise HTTPException(status_code=412, detail="Workspace not initialized")

    try:
        run_uuid = UUID(run_id)
    except ValueError:
        raise HTTPException(status_code=400, detail="Invalid run ID format")

    row = (
        await db.execute(
            select(Run, RunResult)
            .join(RunResult, RunResult.run_id == Run.id, isouter=True)
            .where(Run.id == run_uuid)
        )
    ).one_or_none()
    if not row:
        raise HTTPException(status_code=404, detail="Run not found")

    original_run, original_result = row
    previous_content = original_result.content if original_result else ""
    feedback = body.feedback.strip() or "Make this draft stronger, clearer, and more conversion-focused while preserving the original intent."
    modules = _chat_modules()
    module_cls = next((m for m in modules if m["id"] == original_run.module_id), None)
    channel = (module_cls.get("platform_hint") if module_cls else original_run.module_id.rsplit(".", 1)[-1]) or "asset"

    system = await _build_system_prompt(db, ws, modules) + """

Revision thread mode:
- The user is giving feedback on an existing generated asset.
- Respond as the CMO in one concise sentence about the revision you are making.
- Do not mention module IDs, RUN syntax, APIs, or providers.
- Do not include the revised asset text; it will be rendered separately."""
    messages: list[dict] = [{"role": "system", "content": system}]
    for h in body.history[-8:]:
        messages.append({"role": "user" if h.role == "user" else "assistant", "content": h.text})
    messages.append({
        "role": "user",
        "content": (
            f"Revise this {channel} draft.\n\n"
            f"Previous draft:\n{previous_content}\n\n"
            f"My feedback:\n{feedback}"
        ),
    })

    raw_reply = await _complete_cmo_messages(db, ws, settings, messages)
    reply_text = (_strip_run_directives(raw_reply) if raw_reply else "I revised the draft based on your direction. Review the updated version below.")

    original_run.approval_status = "rejected"
    original_run.feedback = feedback
    await db.flush()

    brief = await _resolve_brief(db, ws, {
        "revision_context": (
            "This is a revision request from a CMO review thread. Rewrite the asset using the feedback below; "
            "do not explain the changes, only output the revised asset.\n\n"
            f"Previous draft:\n{previous_content}\n\n"
            f"Requested change:\n{feedback}"
        )
    })
    revised = await _execute_module(db, ws, original_run.module_id, brief, settings)

    new_run = (await db.execute(select(Run).where(Run.id == UUID(revised.run_id)))).scalar_one_or_none()
    if new_run:
        new_run.parent_run_id = original_run.id
        await db.commit()

    return ChatResponse(
        reply=reply_text,
        runs=[revised],
        run=revised,
        module_id=original_run.module_id,
    )
