{
  "plugin_id": "channel.google_ads",
  "name": "Google Ads Channel",
  "version": "0.4.0",
  "klaroha_min_version": "3.5",
  "capabilities_root": "capabilities/",
  "implements": [
    "marketing.optimize",
    "marketing.execute"
  ],
  "specialty": [
    "paid_search_reporting",
    "account_discovery",
    "campaign_metrics",
    "read_only_data_pull",
    "responsive_search_ad_copy_drafting",
    "approved_mutation_roadmap"
  ],
  "platforms": [
    "google_ads"
  ],
  "connector_protocol": "google_ads_api_rest",
  "risk_policy": "current_capabilities_read_or_draft_only_future_mutations_approval_gated",
  "output_contracts": [
    "google_ads_account_inventory",
    "google_ads_campaign_report",
    "google_ads_data_pull",
    "google_search_ad_draft"
  ],
  "credential_slots": [
    {
      "key": "google_ads_developer_token",
      "type": "platform_var",
      "var": "GOOGLE_ADS_DEVELOPER_TOKEN"
    },
    {
      "key": "google_ads_client_id",
      "type": "platform_var",
      "var": "GOOGLE_ADS_CLIENT_ID"
    },
    {
      "key": "google_ads_client_secret",
      "type": "platform_var",
      "var": "GOOGLE_ADS_CLIENT_SECRET"
    },
    {
      "key": "google_ads_refresh_token",
      "type": "platform_var",
      "var": "GOOGLE_ADS_REFRESH_TOKEN"
    },
    {
      "key": "google_ads_default_customer_id",
      "type": "platform_var",
      "var": "GOOGLE_ADS_DEFAULT_CUSTOMER_ID"
    }
  ],
  "capability_ids": [
    "marketing.channel.google_ads.account.discover",
    "marketing.channel.google_ads.campaigns.read",
    "marketing.channel.google_ads.performance.read",
    "marketing.channel.google_ads.search_text.draft"
  ]
}
