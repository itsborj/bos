DATABASE_URL=postgresql://bos:bos@db:5432/bos
API_SECRET_KEY=          # for signing / encryption
PLATFORM_OPENROUTER_KEY= # platform-mode provider key
ENCRYPTION_KEY=          # for BYOK key encryption at rest

# Facebook Page OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/social/facebook/callback

# Google / Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/social/gmail/callback

# Frontend URL (used for OAuth redirect after callback)
# IMPORTANT: must match the URL your frontend is actually served on.
# If using nginx on port 80, set this to http://localhost (not :3000).
FRONTEND_URL=http://localhost
