{
  "plugin_id": "channel.tiktok",
  "name": "TikTok Specialist",
  "version": "0.1.0",
  "klaroha_min_version": "3.5",
  "capabilities_root": "capabilities/",
  "implements": [
    "marketing.execute",
    "marketing.optimize"
  ],
  "specialty": [
    "tiktok",
    "content_posting_api",
    "direct_post",
    "short_form_video",
    "connector_validation"
  ],
  "platforms": [
    "tiktok"
  ],
  "connector_protocol": "tiktok_content_posting_api_oauth",
  "risk_policy": "connection_validate_is_read_only; direct_post_is_approval_gated",
  "output_contracts": [
    "tiktok_connection_check",
    "tiktok_publish_result"
  ],
  "credential_slots": [
    {
      "key": "access_token",
      "type": "social_token",
      "platform": "tiktok"
    },
    {
      "key": "tiktok_client_key",
      "type": "platform_var",
      "var": "TIKTOK_CLIENT_KEY"
    },
    {
      "key": "tiktok_client_secret",
      "type": "platform_var",
      "var": "TIKTOK_CLIENT_SECRET"
    },
    {
      "key": "tiktok_redirect_uri",
      "type": "platform_var",
      "var": "TIKTOK_REDIRECT_URI"
    },
    {
      "key": "tiktok_scopes",
      "type": "platform_var",
      "var": "TIKTOK_SCOPES",
      "optional": true
    }
  ],
  "connections": [
    {
      "platform": "tiktok",
      "display_name": "TikTok",
      "icon": "🎵"
    }
  ],
  "capability_ids": [
    "marketing.channel.tiktok.connection.validate",
    "marketing.channel.tiktok.video.publish"
  ]
}
