# ── Meta (Facebook / Instagram) OAuth (per-brand channel connection) ─────────
# Setup: developers.facebook.com → Create App (Business type) → Add "Manage Pages" use case
# Enable these permissions in the use case (each must be clicked Add individually):
#   pages_show_list, pages_read_engagement, pages_manage_posts, pages_read_user_content, pages_manage_engagement
# Facebook Login → Settings → Valid OAuth Redirect URIs (https only — localhost does not work):
# Staging:     https://staging.klaroha.com/social/facebook/callback
# Production:  https://hq.klaroha.com/social/facebook/callback
# Settings → Basic → App Domains: staging.klaroha.com, hq.klaroha.com
# Credentials go in Admin → Plugins → Meta Channel (not here) — these are local dev fallbacks only.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost/social/facebook/callback

# ── TikTok OAuth (per-brand channel connection) ───────────────────────────────
# Setup: developers.tiktok.com → app with Login Kit/Open API access.
# Register redirect URIs:
# Local:      http://localhost/social/tiktok/callback
# Staging:    https://staging.klaroha.com/social/tiktok/callback
# Production: https://hq.klaroha.com/social/tiktok/callback
# V1 uses read-only account validation. Posting requires Content Posting API approval.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost/social/tiktok/callback
# Default minimal V1 scope. If TikTok Sandbox only enabled additional scopes,
# use a comma-separated list that exactly matches the app's enabled scopes.
# Example: user.info.basic,user.info.profile,user.info.stats,video.list
TIKTOK_SCOPES=user.info.basic

# ── Gmail + Google Calendar OAuth (per-brand channel connection) ──────────────
# Create a Google OAuth client in Google Cloud Console.
# Enable: Gmail API + Google Calendar API.
# Add BOTH redirect URIs to Authorized redirect URIs in your OAuth client.
# ── Google OAuth — ONE client for all environments ───────────────────────────
# Use a single Google Cloud OAuth client across localhost, staging, and production.
# Register all three callback URIs in Google Console (Credentials → OAuth client → Authorized redirect URIs):
#   http://localhost/social/gmail/callback
#   http://localhost/social/google-calendar/callback
#   http://localhost/social/youtube/callback
#   http://localhost/social/google-drive/callback
#   https://staging.klaroha.com/social/gmail/callback
#   https://staging.klaroha.com/social/google-calendar/callback
#   https://staging.klaroha.com/social/youtube/callback
#   https://staging.klaroha.com/social/google-drive/callback
#   https://hq.klaroha.com/social/gmail/callback
#   https://hq.klaroha.com/social/google-calendar/callback
#   https://hq.klaroha.com/social/youtube/callback
#   https://hq.klaroha.com/social/google-drive/callback
#
# GOOGLE_REDIRECT_URI is no longer required — callback URIs are auto-derived from FRONTEND_URL.
# Copy the same GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET to .env, .env.staging, and .env.production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser API key for the Google Picker (Drive root folder selection). Enable the
# Google Picker API and create a browser-restricted API key in Google Cloud Console.
GOOGLE_PICKER_API_KEY=

# ── Frontend URL — the only env-specific setting ─────────────────────────────
# This drives all OAuth redirect URIs, calendar booking links, and post-OAuth redirects.
# Local: http://localhost  |  Staging: https://staging.klaroha.com  |  Prod: https://hq.klaroha.com
FRONTEND_URL=http://localhost

# ── Auth relay (production / multi-tenant deploy) ─────────────────────────────
# Leave blank for dev mode — direct OAuth using GOOGLE_CLIENT_ID/SECRET above.
# In production: KLAROHA_RELAY_URL=https://auth.klaroha.com
# KLAROHA_RELAY_KEY is issued per-instance by the relay onboarding script.
# See docs/auth-relay-architecture.md for the full setup and security properties.
KLAROHA_RELAY_URL=
KLAROHA_RELAY_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bos:bos@db:5432/bos

# ── Auth ──────────────────────────────────────────────────────────────────────
# Used for Phase 0 middleware; replaced by DB-backed keys in Phase 1
API_SECRET_KEY=change-me-before-deploying

# ── Provider keys (platform mode / local extensions) ──────────────────────────
# For local extension "nvidia", use NVIDIA_API_KEY (used by extensions/nvidia/index.ts)
NVIDIA_API_KEY=
PLATFORM_OPENROUTER_KEY=
PLATFORM_GEMINI_KEY=
PLATFORM_NVIDIA_KEY=         # NVIDIA NGC / NVIDIA AI Cloud API key
PLATFORM_OPENAI_KEY=

# ── Google Ads API connector (optional, read-only first) ─────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=        # optional manager ID without dashes, e.g. 4563379450
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=      # client/test account ID without dashes

# ── Google Search Console API connector (optional, read-only first) ──────────
# Custom BOS plugin uses native Google Search Console APIs only.
# No Membrane, Rube, Composio, or MCP sidecar.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_DEFAULT_SITE_URL=  # e.g. sc-domain:example.com or https://www.example.com/

# ── ClickUp API connector (optional, personal token) ─────────────────────────
# Personal API token from ClickUp Settings > Apps (starts with pk_...)
# CLICKUP_TEAM_ID is the Workspace ID (confusingly named "team_id" in ClickUp API).
# No default list — tasks.read scans the full workspace; tasks.create targets
# the list specified in brief["list_id"] or brief["list_name"].
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# ── Image generation (media.image plugin) ─────────────────────────────────────
# Provider-agnostic. Currently backed by Cloudflare Workers AI.
# To swap providers: update IMAGE_GEN_WORKER_URL and IMAGE_GEN_API_KEY only.
# Store via Admin UI: POST /plugins/media.image/credentials
IMAGE_GEN_WORKER_URL=https://cloudflare-worker.jvcatingub.workers.dev/
IMAGE_GEN_API_KEY=

# ── BYOK encryption ───────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Billing ───────────────────────────────────────────────────────────────────
MARKUP_MULTIPLIER=1.35

# ── Model / execution backend routing ────────────────────────────────────────
# Main CMO chat model. Format: provider:model_id. Leave blank for normal waterfall.
# Examples: gemini:gemini-2.0-flash, openrouter:openai/gpt-4o-mini, nvidia:meta/llama-3.3-70b-instruct
CMO_CHAT_MODEL=

# Modality-aware backend overrides keyed by target. This is the preferred format.
# Targets may be cmo.main, module IDs, or future evaluator IDs. Text module model IDs
# must exist as healthy model_options for that module's capability.
# Example:
# EXECUTION_BACKEND_OVERRIDES={"cmo.main":{"provider":"openai","model_id":"gpt-5.1","modality":"text","strict":true},"marketing.channel.facebook.paid.ads.copy":{"provider":"openrouter","model_id":"anthropic/claude-3.5-sonnet","modality":"text","strict":true},"marketing.channel.instagram.creative.image.generate":{"provider":"openai","model_id":"gpt-image-1","modality":"image","strict":true}}
EXECUTION_BACKEND_OVERRIDES={}

# Backward-compatible per-module text model overrides as JSON.
# Example:
# MODULE_MODEL_OVERRIDES={"marketing.ad_copy.facebook":"openrouter:openai/gpt-4o-mini","marketing.email.sequence":"gemini:gemini-2.0-flash"}
MODULE_MODEL_OVERRIDES={}

# true = configured module backend must be used; false = try it first, then use normal fallback candidates.
STRICT_MODEL_OVERRIDES=true

# ── App ───────────────────────────────────────────────────────────────────────
APP_VERSION=0.1.0
