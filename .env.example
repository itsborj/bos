# ── Gmail + Google Calendar OAuth (per-brand channel connection) ──────────────
# Create a Google OAuth client in Google Cloud Console.
# Enable: Gmail API + Google Calendar API.
# Add BOTH redirect URIs to Authorized redirect URIs in your OAuth client.
# Local (nginx on :80):   http://localhost/social/gmail/callback
# Production:             https://hq.klaroha.com/social/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/social/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost/social/google-calendar/callback

# ── Frontend URL (used for post-OAuth redirects) ───────────────────────────────
# Local docker/nginx serves the app on http://localhost. Match the actual browser URL.
FRONTEND_URL=http://localhost

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bos:bos@db:5432/bos

# ── Auth ──────────────────────────────────────────────────────────────────────
# Used for Phase 0 middleware; replaced by DB-backed keys in Phase 1
API_SECRET_KEY=change-me-before-deploying

# ── Provider keys (platform mode / local extensions) ──────────────────────────
# For local extension "nvidia", use NVIDIA_API_KEY (used by extensions/nvidia/index.ts)
NVIDIA_API_KEY=
PLATFORM_OPENROUTER_KEY=
PLATFORM_GEMINI_KEY=
PLATFORM_NVIDIA_KEY=         # NVIDIA NGC / NVIDIA AI Cloud API key
PLATFORM_OPENAI_KEY=

# ── Google Ads API connector (optional, read-only first) ─────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=        # optional manager ID without dashes, e.g. 4563379450
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=      # client/test account ID without dashes

# ── Google Search Console API connector (optional, read-only first) ──────────
# Custom BOS plugin uses native Google Search Console APIs only.
# No Membrane, Rube, Composio, or MCP sidecar.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_DEFAULT_SITE_URL=  # e.g. sc-domain:example.com or https://www.example.com/

# ── ClickUp API connector (optional, personal token) ─────────────────────────
# Personal API token from ClickUp Settings > Apps (starts with pk_...)
# CLICKUP_TEAM_ID is the Workspace ID (confusingly named "team_id" in ClickUp API).
# No default list — tasks.read scans the full workspace; tasks.create targets
# the list specified in brief["list_id"] or brief["list_name"].
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# ── Image generation (media.image plugin) ─────────────────────────────────────
# Provider-agnostic. Currently backed by Cloudflare Workers AI.
# To swap providers: update IMAGE_GEN_WORKER_URL and IMAGE_GEN_API_KEY only.
# Store via Admin UI: POST /plugins/media.image/credentials
IMAGE_GEN_WORKER_URL=https://cloudflare-worker.jvcatingub.workers.dev/
IMAGE_GEN_API_KEY=

# ── BYOK encryption ───────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Billing ───────────────────────────────────────────────────────────────────
MARKUP_MULTIPLIER=1.35

# ── Model / execution backend routing ────────────────────────────────────────
# Main CMO chat model. Format: provider:model_id. Leave blank for normal waterfall.
# Examples: gemini:gemini-2.0-flash, openrouter:openai/gpt-4o-mini, nvidia:meta/llama-3.3-70b-instruct
CMO_CHAT_MODEL=

# Modality-aware backend overrides keyed by target. This is the preferred format.
# Targets may be cmo.main, module IDs, or future evaluator IDs. Text module model IDs
# must exist as healthy model_options for that module's capability.
# Example:
# EXECUTION_BACKEND_OVERRIDES={"cmo.main":{"provider":"openai","model_id":"gpt-5.1","modality":"text","strict":true},"marketing.channel.facebook.paid.ads.copy":{"provider":"openrouter","model_id":"anthropic/claude-3.5-sonnet","modality":"text","strict":true},"marketing.channel.instagram.creative.image.generate":{"provider":"openai","model_id":"gpt-image-1","modality":"image","strict":true}}
EXECUTION_BACKEND_OVERRIDES={}

# Backward-compatible per-module text model overrides as JSON.
# Example:
# MODULE_MODEL_OVERRIDES={"marketing.ad_copy.facebook":"openrouter:openai/gpt-4o-mini","marketing.email.sequence":"gemini:gemini-2.0-flash"}
MODULE_MODEL_OVERRIDES={}

# true = configured module backend must be used; false = try it first, then use normal fallback candidates.
STRICT_MODEL_OVERRIDES=true

# ── App ───────────────────────────────────────────────────────────────────────
APP_VERSION=0.1.0
